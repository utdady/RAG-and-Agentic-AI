# Copy to .env — or reuse Meeting Assistant/.env (app loads that too)

LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_MODEL=
HARDWARE_TIER=

# Local FAISS embeddings (no API key)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Truncate transcript sent to the summarizer (chars)
SUMMARY_MAX_CHARS=12000
