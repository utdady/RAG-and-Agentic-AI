# Optional — Context7 HTTP may require a key for higher limits
CONTEXT7_API_KEY=
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp

# Calculator MCP HTTP (labs 05–06)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# Agent LLM (repo-root .env preferred)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=llama3.2
