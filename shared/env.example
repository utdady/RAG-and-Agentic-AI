# Shared defaults — prefer copying repo-root `env.example` → `.env`
# (RAG and Agentic AI/.env). Apps load root first, then project `.env` overrides.

# auto = Groq if GROQ_API_KEY is set, else Ollama
LLM_PROVIDER=auto

# --- Groq (free API) https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Ollama local fallback https://ollama.com ---
# Leave OLLAMA_MODEL empty to auto-pick from machine tier
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=llava
# Optional force: low | mid | high
HARDWARE_TIER=

# Whisper override (else tier-based: tiny / base / small)
WHISPER_MODEL=

# Local embeddings for FAISS / RAG (YouTube Summarizer, etc.)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Google AI Studio (Gradio Labs text→image) https://aistudio.google.com/apikey ---
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
