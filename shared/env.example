# Shared LLM defaults for this repo (copy into a project .env or repo-root .env)

# auto = Groq if GROQ_API_KEY is set, else Ollama
LLM_PROVIDER=auto

# --- Groq (free API) https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama local fallback https://ollama.com ---
# Leave OLLAMA_MODEL empty to auto-pick from machine tier
OLLAMA_MODEL=
# Optional force: low | mid | high
HARDWARE_TIER=

# Whisper override (else tier-based: tiny / base / small)
WHISPER_MODEL=

# Local embeddings for FAISS / RAG (YouTube Summarizer, etc.)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
