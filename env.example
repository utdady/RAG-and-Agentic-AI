# Repo-root shared secrets — copy to `.env` in this folder
# (RAG and Agentic AI/.env). Gitignored. Preferred over per-project copies.
#
# Project folders may still have their own `.env` for overrides;
# apps load root first, then the project file (project wins).

# auto = Groq if GROQ_API_KEY is set, else Ollama
LLM_PROVIDER=auto

# --- Groq https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Ollama https://ollama.com ---
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=llava
HARDWARE_TIER=

WHISPER_MODEL=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Meeting Assistant optional
ENABLE_PRODUCT_ASSISTANT=false

# --- Tavily search (langgraph_101/05–06) https://tavily.com ---
TAVILY_API_KEY=

# --- Serper search (CrewAI Labs) https://serper.dev ---
SERPER_API_KEY=

# --- Google AI Studio (Gradio Labs text→image) https://aistudio.google.com/apikey ---
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
