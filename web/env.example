# --- Local dev (default) ---
# Browser uses same-origin /api/hub → localhost:8080. No vars required.

# --- Production (Vercel) ---
# Direct browser → API (recommended for SSE demos):
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# Portfolio link in hub header/sidebar:
# NEXT_PUBLIC_PORTFOLIO_URL=https://utdady.github.io
# Optional server-side proxy target for /api/hub route:
# API_PROXY_URL=https://your-api.up.railway.app
