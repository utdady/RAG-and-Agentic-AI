# --- Local dev (default) ---
# Browser uses same-origin /api/hub → localhost:8080. No vars required.

# --- Production (Vercel) ---
# Direct browser → API (required for long SSE demos; avoids proxy timeouts):
# NEXT_PUBLIC_API_URL=https://ai-lab-api-fywf.onrender.com
# Portfolio link in hub header/sidebar:
# NEXT_PUBLIC_PORTFOLIO_URL=https://aditya-bhaskar.vercel.app
# Optional server-side proxy target for /api/hub route:
# API_PROXY_URL=https://ai-lab-api-fywf.onrender.com
