LLM_PROVIDER=auto
GROQ_API_KEY=

# Slot: llama (fast)
LLAMA_PROVIDER=auto
LLAMA_MODEL=llama-3.1-8b-instant
LLAMA_OLLAMA_MODEL=llama3.2:3b

# Slot: granite UI label → Gemma/balanced (or Ollama granite if you set it)
GRANITE_PROVIDER=auto
GRANITE_MODEL=gemma2-9b-it
GRANITE_OLLAMA_MODEL=gemma2:2b

# Slot: mistral UI key → quality / larger model
MISTRAL_PROVIDER=auto
MISTRAL_MODEL=llama-3.3-70b-versatile
MISTRAL_OLLAMA_MODEL=mistral:7b

MAX_NEW_TOKENS=256
TEMPERATURE=0.2
