# Copy to Meeting Assistant/.env only for *project-specific* overrides.
# Prefer secrets in the repo-root `.env` (see ../env.example).

# auto = Groq if GROQ_API_KEY is set, else Ollama
LLM_PROVIDER=auto

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama local fallback — leave OLLAMA_MODEL empty for hardware auto-pick
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=llava
# Optional: low | mid | high
HARDWARE_TIER=

# Whisper override (else auto: tiny / base / small by tier)
WHISPER_MODEL=

# Earnings-call term cleanup (uses same LLM; default off)
ENABLE_PRODUCT_ASSISTANT=false

# Google AI Studio — usually set in repo-root .env
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
