# Copy to .env (project folder and/or repo root)

# auto = Groq if GROQ_API_KEY is set, else Ollama
LLM_PROVIDER=auto

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local fallback — leave OLLAMA_MODEL empty for hardware auto-pick
OLLAMA_MODEL=
# Optional: low | mid | high
HARDWARE_TIER=

# Whisper override (else auto: tiny / base / small by tier)
WHISPER_MODEL=

# Earnings-call term cleanup (uses same LLM; default off)
ENABLE_PRODUCT_ASSISTANT=false
