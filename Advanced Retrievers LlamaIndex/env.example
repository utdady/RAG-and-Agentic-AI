# Same provider env as Meeting Assistant / YouTube Summarizer
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_MODEL=
HARDWARE_TIER=

# Local embeddings for LlamaIndex
LLAMA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Skip DocumentSummaryIndex build (saves LLM calls)
SKIP_DOC_SUMMARY=false
